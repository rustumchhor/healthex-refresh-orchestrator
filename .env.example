# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthex

# --- Process role -------------------------------------------------------
# all       : scheduler + workers + admin API + mock EHR in one process (npm start)
# scheduler : scheduler loop only
# worker    : worker loop only
# api       : admin API only
# mock-ehr  : mock EHR service only
ROLE=all

# --- Workers ---
WORKER_COUNT=2
WORKER_BATCH_SIZE=5
WORKER_IDLE_MS=500

# How long a claimed job stays leased to a worker. Must exceed the worst-case
# time for a single EHR HTTP call, since one job = one call (see README).
LEASE_SECONDS=30

# --- Job execution ---
POLL_INTERVAL_SECONDS=1
JOB_DEADLINE_SECONDS=300
MAX_ATTEMPTS=4
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=300

# --- Scheduler ---
SCHEDULER_TICK_MS=2000
SCHEDULER_BATCH_LIMIT=500
# Fraction of the tightest due interval used as a jitter window, capped.
JITTER_FRACTION=0.1
JITTER_MAX_SECONDS=3600
# Enrollments whose consent expires inside this window get a priority boost.
CONSENT_URGENCY_DAYS=7
CONSENT_PRIORITY_BOOST=500

# A terminal failure does not advance last_refresh_at, so without a quarantine
# the patient stays "due" and the scheduler recreates the same doomed job every
# tick — paying for the API call each time. Neither window is infinite: consent
# gets re-granted and patient records get corrected.
TRANSIENT_QUARANTINE_SECONDS=900
PERMANENT_QUARANTINE_SECONDS=86400

# --- HTTP ---
ADMIN_PORT=4000
MOCK_EHR_PORT=4010

# --- Mock EHR ---
# Multiplier applied to each endpoint's advertised rate limit inside the mock.
# 1.0 = mock enforces exactly the documented limit.
MOCK_RATE_LIMIT_FACTOR=1.0
LOG_LEVEL=info
